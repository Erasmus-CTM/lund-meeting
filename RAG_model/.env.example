# RAG Application Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================
# You MUST set these variables for the application to work

# API key for LLM access (OpenAI, Ollama, or other compatible API)
# Example: sk-abc123... (OpenAI) or your-ollama-key
export LLM_API_KEY=

# Embeddings API endpoint URL
# Example: https://api.openai.com/v1/embeddings
# Example: http://localhost:11434/v1/embeddings (Ollama)
export EMBEDDINGS_URL=

# Embeddings model name
# Example: text-embedding-3-small (OpenAI)
# Example: nomic-embed-text (Ollama)
export EMBEDDINGS_MODEL=

# Chat completions API endpoint URL
# Example: https://api.openai.com/v1/chat/completions
# Example: http://localhost:11434/v1/chat/completions (Ollama)
export CHAT_URL=

# Chat model name
# Example: gpt-4, gpt-3.5-turbo (OpenAI)
# Example: llama3.1, qwen2.5:14b (Ollama)
export CHAT_MODEL=

# Path to notes repository containing .md/.qmd files for ingestion
# This is the directory that will be scanned during the ingest process
# Example: /home/rag/notes_repo/pages or ./notes_repo/pages
export NOTES_REPO_DIR=

# ============================================================================
# OPTIONAL CONFIGURATION (with defaults)
# ============================================================================
# Uncomment and modify if you want to override the defaults

# Temperature for chat generation (0.0 = deterministic, 1.0 = creative)
# export CHAT_TEMPERATURE=0.2

# Maximum tokens for chat responses
# export CHAT_MAX_TOKENS=900

# Enable Flask debug mode (true/false)
# export DEBUG=false

# LLM request timeout in seconds
# export LLM_TIMEOUT=30

# Path to vector database directory
# export VECTOR_DB_PATH=./vector_store

# Number of chunks to retrieve during search
# export TOP_K=5

# Maximum question length in characters
# export MAX_QUESTION_LENGTH=1000

# ============================================================================
# RAG-SPECIFIC SETTINGS
# ============================================================================

# Default top-k for retrieval
# export RAG_TOP_K_DEFAULT=3

# Maximum characters per chunk when building prompts
# export RAG_MAX_CHARS_PER_CHUNK=1200

# Minimum characters in best chunk for "full" coverage heuristic
# export RAG_MIN_BEST_CHUNK_CHARS_FOR_FULL=120

# Temperature for notes-first answer generation (pass 1)
# export RAG_NOTES_TEMPERATURE=0.2

# Maximum tokens for notes-based answers
# export RAG_NOTES_MAX_TOKENS=450

# Temperature for extra context generation (pass 2)
# export RAG_EXTRA_TEMPERATURE=0.5

# Maximum tokens for extra context
# export RAG_EXTRA_MAX_TOKENS=900

# Default extra mode (auto/always/never)
# auto = only add extra when notes coverage isn't full
# always = always add extra context
# never = never add extra context
# export RAG_EXTRA_MODE_DEFAULT=auto

# Include extra context by default (1 = yes, 0 = no)
# export RAG_INCLUDE_EXTRA_DEFAULT=1
